<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext is permitted globally so debrid CDN stream URLs (HTTP) keep working.
        System trust anchors are explicitly listed so user-installed CA certs are NOT
        trusted, which prevents MITM via sideloaded root certs.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
